<?xml version="1.0"?>
<package format="3">
  <name>elderly_care_robot_sim</name>
  <version>0.1.0</version>
  <description>Simulation of a socially-aware assistive robot in a home environment for elderly care</description>
  <maintainer email="GutierrezTorresMM@cardiff.ac.uk">Miguel Gutierrez Torres</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- Tiago-Harmonic packages, see tiago.repos -->
  <exec_depend>tiago_bringup</exec_depend>
  <exec_depend>tiago_description</exec_depend>
  <exec_depend>pmb2_description</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>twist_stamper</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
