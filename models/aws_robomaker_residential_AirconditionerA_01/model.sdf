<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="aws_robomaker_residential_AirconditionerA_01">
    <link name="link">
      <inertial>
        <mass>1</mass>
      </inertial>
      <!-- No collision: the robot cannot touch this (on a wall, ceiling or other furniture),
           and mesh collisions made DART run the house at 0.12x real time. -->
      <visual name="visual">
	    <geometry>
          <mesh>
            <uri>model://aws_robomaker_residential_AirconditionerA_01/meshes/aws_AirconditionerA_01_visual.DAE</uri>
          </mesh>
        </geometry>
      <meta> <layer> 1 </layer></meta>
</visual>
    </link>
	<static>1</static>
  </model>
</sdf>
