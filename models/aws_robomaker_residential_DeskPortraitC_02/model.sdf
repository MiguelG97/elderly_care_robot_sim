<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="aws_robomaker_residential_DeskPortraitC_02">
    <link name="link">
      <inertial>
        <mass>1</mass>
        <inertia>
            <ixx>0.0835</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16</iyy>
            <iyz>0</iyz>
            <izz>0.08347</izz>
        </inertia>
      </inertial>
      <!-- No collision: the robot cannot touch this (on a wall, ceiling or other furniture),
