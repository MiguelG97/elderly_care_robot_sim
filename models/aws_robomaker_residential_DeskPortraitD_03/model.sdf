<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="aws_robomaker_residential_DeskPortraitD_03">
    <link name="link">
      <inertial>
        <mass>0.4</mass>
          <inertia>
          <!-- 
            <ixx>0.02</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.04</iyy>
            <iyz>0</iyz>
            <izz>0.02</izz>
          -->
          <!-- stabilizes late
            <ixx>0.0835</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16</iyy>
            <iyz>0</iyz>
            <izz>0.08347</izz>
          -->
            <ixx>0.0616</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.1313</iyy>
            <iyz>0</iyz>
            <izz>0.0803</izz>
          </inertia>
      </inertial>


      <!-- No collision: the robot cannot touch this (on a wall, ceiling or other furniture),
           and mesh collisions made DART run the house at 0.12x real time. -->

      
      <visual name="visual">
	    <geometry>
          <mesh>
            <uri>model://aws_robomaker_residential_DeskPortraitD_03/meshes/aws_DeskPortraitD_01_visual.DAE</uri>
          </mesh>
        </geometry>
      <meta> <layer> 1 </layer></meta>
</visual>
    </link>
