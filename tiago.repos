# TIAGo for ROS 2 Jazzy + Gazebo Harmonic: the Tiago-Harmonic community port of
# PAL Robotics' packages (Apache-2.0), as listed in
# https://github.com/Tiago-Harmonic/tiago_harmonic/blob/jazzy/dependencies.repos
#
#   cd ~/ros2_ws/src
#   vcs import . < elderly_care_robot_sim/tiago.repos
#   cd ~/ros2_ws && rosdep install --from-paths src --ignore-src -r -y
#   colcon build --symlink-install
repositories:
  br2_gazebo_worlds:
    type: git
    url: https://github.com/Tiago-Harmonic/br2_gazebo_worlds.git
    version: main
  launch_pal:
    type: git
    url: https://github.com/Tiago-Harmonic/launch_pal.git
    version: master
  pal_gripper:
    type: git
    url: https://github.com/Tiago-Harmonic/pal_gripper.git
    version: jazzy
  pal_hey5:
    type: git
    url: https://github.com/Tiago-Harmonic/pal_hey5.git
    version: jazzy
  pal_maps:
    type: git
    url: https://github.com/Tiago-Harmonic/pal_maps.git
    version: main
  pal_robotiq_gripper:
    type: git
    url: https://github.com/Tiago-Harmonic/pal_robotiq_gripper.git
    version: jazzy
  pal_urdf_utils:
    type: git
    url: https://github.com/Tiago-Harmonic/pal_urdf_utils.git
    version: jazzy
  play_motion2:
    type: git
    url: https://github.com/Tiago-Harmonic/play_motion2.git
    version: jazzy
  pmb2_navigation:
    type: git
    url: https://github.com/Tiago-Harmonic/pmb2_navigation.git
    version: jazzy
  pmb2_robot:
    type: git
    url: https://github.com/Tiago-Harmonic/pmb2_robot.git
    version: jazzy
  tiago_moveit_config:
    type: git
    url: https://github.com/Tiago-Harmonic/tiago_moveit_config.git
    version: jazzy
  tiago_navigation:
    type: git
    url: https://github.com/Tiago-Harmonic/tiago_navigation
    version: jazzy
  tiago_omni_base:
    type: git
    url: https://github.com/Tiago-Harmonic/omni_base_robot.git
    version: jazzy
  tiago_robot:
    type: git
    url: https://github.com/Tiago-Harmonic/tiago_robot.git
    version: jazzy
  tiago_simulation:
    type: git
    url: https://github.com/Tiago-Harmonic/tiago_simulation.git
    version: jazzy
