<?xml version="1.0"?>
<!--
  Gazebo server systems, loaded by robot_in_house.launch.py through
  GZ_SIM_SERVER_CONFIG_PATH.

  The world files declare no <plugin>, so Gazebo would load only its default set
  (physics, user commands, scene broadcaster), which has no sensor systems, and
  TIAGo's URDF does not bring its own: without Sensors and Imu here, its laser and
  IMU publish nothing.
-->
<server_config>
  <plugins>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin entity_name="*" entity_type="world"
            filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </plugins>
</server_config>
